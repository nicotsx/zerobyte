SERVER_IP=localhost
ZEROBYTE_DATABASE_URL=./data/zerobyte.db
RESTIC_CACHE_DIR=./data/restic/cache
ZEROBYTE_REPOSITORIES_DIR=./data/repositories
ZEROBYTE_VOLUMES_DIR=./data/volumes
# Standalone agents only: JSON allow-list of local filesystem roots. Restore access defaults to false.
# ZEROBYTE_AGENT_ROOTS=[{"id":"home","label":"Home","path":"~/home"}]
# Standalone remote agent only; the token is shown once when an admin enrolls the agent.
# Production public enrollment always requires verified TLS. For local production testing,
# put the build behind Portless or another TLS reverse proxy; plain HTTP returns 426.
# ZEROBYTE_CONTROLLER_URL=wss://zerobyte.example.com/api/v1/agents/connect
# ZEROBYTE_AGENT_TOKEN=zba1....
APP_SECRET=<openssl rand -hex 32>
BASE_URL=http://*.localhost
TRUST_PROXY=false
PORT=3000
