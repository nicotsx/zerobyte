{
	"version": 1,
	"resticPassword": "test-restic-password",
	"repositories": [
		{
			"ref": "repository:1",
			"name": "Fixture Primary Repository",
			"config": {
				"backend": "rclone",
				"remote": "fixture-primary",
				"path": "/primary",
				"customPassword": "fixture-primary-password",
				"uploadLimit": {
					"enabled": true,
					"value": 100,
					"unit": "Mbps"
				},
				"downloadLimit": {
					"enabled": false,
					"value": 5,
					"unit": "Kbps"
				}
			},
			"compressionMode": "max",
			"autoCheckEnabled": true
		},
		{
			"ref": "repository:2",
			"name": "Fixture Mirror Repository",
			"config": {
				"backend": "rclone",
				"remote": "fixture-mirror",
				"path": "/mirror",
				"uploadLimit": {
					"enabled": false,
					"value": 5,
					"unit": "Kbps"
				},
				"downloadLimit": {
					"enabled": true,
					"value": 9,
					"unit": "Mbps"
				}
			},
			"compressionMode": "off",
			"autoCheckEnabled": false
		}
	],
	"volumes": [
		{
			"ref": "volume:1",
			"name": "Fixture Volume",
			"config": {
				"backend": "rclone",
				"remote": "fixture-volume",
				"path": "/data",
				"readOnly": true
			},
			"autoRemount": false
		}
	],
	"backupSchedules": [
		{
			"ref": "schedule:1",
			"name": "Fixture Nightly Backup",
			"volumeRef": "volume:1",
			"repositoryRef": "repository:1",
			"enabled": true,
			"cronExpression": "0 2 * * *",
			"retentionPolicy": {
				"keepLast": 5,
				"keepDaily": 2,
				"keepWithinDuration": "30d"
			},
			"excludePatterns": ["*.tmp", "cache/**"],
			"excludeIfPresent": [".nobackup"],
			"includePaths": ["/Documents"],
			"includePatterns": ["**/*.md"],
			"oneFileSystem": true,
			"customResticParams": ["--pack-size 64"],
			"compressionMode": null,
			"backupWebhooks": null,
			"maxRetries": 4,
			"retryDelay": 120000,
			"sortOrder": 8
		}
	],
	"notificationDestinations": [
		{
			"ref": "destination:1",
			"name": "Fixture Notification",
			"enabled": true,
			"config": {
				"type": "generic",
				"url": "https://example.com/fixture-webhook",
				"method": "POST",
				"contentType": "application/json",
				"headers": ["X-Fixture: true"],
				"useJson": true,
				"titleKey": "title",
				"messageKey": "message"
			}
		}
	],
	"backupScheduleMirrors": [
		{
			"scheduleRef": "schedule:1",
			"repositoryRef": "repository:2",
			"enabled": false
		}
	],
	"backupScheduleNotifications": [
		{
			"scheduleRef": "schedule:1",
			"destinationRef": "destination:1",
			"notifyOnStart": true,
			"notifyOnSuccess": false,
			"notifyOnWarning": true,
			"notifyOnFailure": false
		}
	]
}
