{
	"version": 3,
	"resticPassword": "test-restic-password",
	"repositories": [
		{
			"ref": "repository:1",
			"machineRef": null,
			"name": "Fixture Primary Repository",
			"config": {
				"backend": "rclone",
				"remote": "fixture-primary",
				"path": "/primary",
				"customPassword": "fixture-primary-password",
				"uploadLimit": {
					"enabled": true,
					"value": 100,
					"unit": "Mbps"
				},
				"downloadLimit": {
					"enabled": false,
					"value": 5,
					"unit": "Kbps"
				}
			},
			"compressionMode": "max",
			"autoCheckEnabled": true
		},
		{
			"ref": "repository:2",
			"machineRef": null,
			"name": "Fixture Mirror Repository",
			"config": {
				"backend": "rclone",
				"remote": "fixture-mirror",
				"path": "/mirror",
				"uploadLimit": {
					"enabled": false,
					"value": 5,
					"unit": "Kbps"
				},
				"downloadLimit": {
					"enabled": true,
					"value": 9,
					"unit": "Mbps"
				}
			},
			"compressionMode": "off",
			"autoCheckEnabled": false
		},
		{
			"ref": "repository:agent",
			"name": "Workstation Repository",
			"machineRef": "machine:1",
			"config": {
				"backend": "local",
				"path": "restic/workstation",
				"trustedRootId": "files-1"
			},
			"compressionMode": "auto",
			"autoCheckEnabled": false
		}
	],
	"volumes": [
		{
			"ref": "volume:1",
			"name": "Fixture Volume",
			"config": {
				"backend": "rclone",
				"remote": "fixture-volume",
				"path": "/data",
				"readOnly": true
			},
			"autoRemount": false,
			"sourceKind": "managed",
			"machineRef": null
		},
		{
			"ref": "volume:remote",
			"name": "Remote documents",
			"machineRef": "machine:1",
			"autoRemount": false,
			"sourceKind": "agent-filesystem",
			"trustedRootId": "documents",
			"relativePath": "projects"
		},
		{
			"ref": "volume:local",
			"name": "Local photos",
			"machineRef": null,
			"autoRemount": false,
			"sourceKind": "agent-filesystem",
			"trustedRootId": "photos",
			"relativePath": ""
		}
	],
	"backupSchedules": [
		{
			"ref": "schedule:1",
			"shortId": "sched001",
			"name": "Fixture Nightly Backup",
			"volumeRef": "volume:1",
			"repositoryRef": "repository:1",
			"enabled": true,
			"cronExpression": "0 2 * * *",
			"retentionPolicy": {
				"keepLast": 5,
				"keepDaily": 2,
				"keepWithinDuration": "30d"
			},
			"excludePatterns": ["*.tmp", "cache/**"],
			"excludeIfPresent": [".nobackup"],
			"includePaths": ["/Documents"],
			"includePatterns": ["**/*.md"],
			"oneFileSystem": true,
			"customResticParams": ["--pack-size 64"],
			"compressionMode": "off",
			"backupWebhooks": null,
			"maxRetries": 4,
			"retryDelay": 120000,
			"sortOrder": 8
		},
		{
			"ref": "schedule:filesystem:0",
			"shortId": "fsbackup0",
			"name": "Filesystem backup 0",
			"volumeRef": "volume:remote",
			"repositoryRef": "repository:1",
			"enabled": true,
			"cronExpression": "0 2 * * *",
			"retentionPolicy": {
				"keepLast": 5,
				"keepDaily": 2,
				"keepWithinDuration": "30d"
			},
			"excludePatterns": ["*.tmp", "cache/**"],
			"excludeIfPresent": [".nobackup"],
			"includePaths": ["/Documents"],
			"includePatterns": ["**/*.md"],
			"oneFileSystem": true,
			"customResticParams": ["--pack-size 64"],
			"compressionMode": "off",
			"backupWebhooks": null,
			"maxRetries": 4,
			"retryDelay": 120000,
			"sortOrder": 8
		},
		{
			"ref": "schedule:filesystem:1",
			"shortId": "fsbackup1",
			"name": "Filesystem backup 1",
			"volumeRef": "volume:local",
			"repositoryRef": "repository:1",
			"enabled": true,
			"cronExpression": "0 2 * * *",
			"retentionPolicy": {
				"keepLast": 5,
				"keepDaily": 2,
				"keepWithinDuration": "30d"
			},
			"excludePatterns": ["*.tmp", "cache/**"],
			"excludeIfPresent": [".nobackup"],
			"includePaths": ["/Documents"],
			"includePatterns": ["**/*.md"],
			"oneFileSystem": true,
			"customResticParams": ["--pack-size 64"],
			"compressionMode": "off",
			"backupWebhooks": null,
			"maxRetries": 4,
			"retryDelay": 120000,
			"sortOrder": 8
		},
		{
			"ref": "schedule:agent",
			"shortId": "agentrp1",
			"name": "Workstation Repository Backup",
			"volumeRef": "volume:remote",
			"repositoryRef": "repository:agent",
			"enabled": true,
			"cronExpression": "0 3 * * *",
			"retentionPolicy": null,
			"excludePatterns": [],
			"excludeIfPresent": [],
			"includePaths": [],
			"includePatterns": [],
			"oneFileSystem": false,
			"customResticParams": [],
			"compressionMode": null,
			"backupWebhooks": null,
			"maxRetries": 2,
			"retryDelay": 60000,
			"sortOrder": 9
		}
	],
	"notificationDestinations": [
		{
			"ref": "destination:1",
			"name": "Fixture Notification",
			"enabled": true,
			"config": {
				"type": "generic",
				"url": "https://example.com/fixture-webhook",
				"method": "POST",
				"contentType": "application/json",
				"headers": ["X-Fixture: true"],
				"useJson": true,
				"titleKey": "title",
				"messageKey": "message"
			}
		}
	],
	"backupScheduleMirrors": [
		{
			"scheduleRef": "schedule:1",
			"repositoryRef": "repository:2",
			"enabled": false
		}
	],
	"backupScheduleNotifications": [
		{
			"scheduleRef": "schedule:1",
			"destinationRef": "destination:1",
			"notifyOnStart": true,
			"notifyOnSuccess": false,
			"notifyOnWarning": true,
			"notifyOnFailure": false
		}
	],
	"machines": [
		{
			"ref": "machine:1",
			"name": "Remote workstation"
		}
	]
}
